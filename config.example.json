{
  "listen": "127.0.0.1:8080",
  "server_keys": ["change-this-local-key"],
  "zen_keys": ["sk-your-zen-key"],
  "go_keys": [],
  "anonymous": false,
  "proxies": ["direct"],
  "proxyfile": "",
  "proxyclean": {
    "enabled": false,
    "sources": ["proxyclean"],
    "scope": "anonymous-only",
    "source_url": "https://raw.githubusercontent.com/HankNovic/ProxyClean/refs/heads/main/SOCKS5.txt",
    "refresh_seconds": 3600,
    "ttl_seconds": 7200,
    "probe_interval_seconds": 300,
    "probe_timeout_seconds": 8,
    "probe_concurrency": 8,
    "max_candidates": 100,
    "max_nodes": 20,
    "cooldown_seconds": 60,
    "allow_direct_fallback": false
  },
  "upstream": {
    "zen": "https://opencode.ai/zen",
    "go": "https://opencode.ai/zen/go",
    "anonymous": "https://opencode.ai/inference"
  },
  "retry": {
    "max_attempts": 3,
    "timeout_seconds": 300,
    "backoff_initial_ms": 0,
    "backoff_max_ms": 0
  },
  "models": {
    "refresh_seconds": 300,
    "protocols": {},
    "free_only": false
  },
  "performance": {
    "max_idle_conns": 2048,
    "max_idle_conns_per_host": 256,
    "max_conns_per_host": 0,
    "idle_conn_timeout_seconds": 120,
    "connect_timeout_seconds": 5,
    "failure_cooldown_seconds": 15,
    "attempt_timeout_seconds": 0,
    "first_event_timeout_seconds": 0
  },
  "logging": {
    "level": "info",
    "ring_size": 2000,
    "dump_request_bodies": false
  },
  "webui": {
    "enabled": true,
    "listen": "0.0.0.0:8081",
    "username": "admin",
    "password": "change-this-admin-password",
    "session_ttl_minutes": 720
  },
  "prefer": "go",
  "reasoning": {
    "effort": "high",
    "effort_by_model": {}
  },
  "rotation": {
    "sota": {
      "alias": "sota",
      "order": ["deepseek-v4.1-flash", "glm-5.3", "grok-4.6", "kimi-k3", "qwen3.8-max"]
    },
    "sweet": {
      "alias": "sweet",
      "order": []
    },
    "first_output_seconds": 30
  }
}
